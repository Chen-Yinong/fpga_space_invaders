        <mxCell id="a_2ff" value="&lt;b&gt;2FF 同步器 ★CDC&lt;/b&gt;&lt;br&gt;pclk→50MHz&lt;br&gt;镜像反转(左右对调)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;fontSize=11;" vertex="1" parent="1">

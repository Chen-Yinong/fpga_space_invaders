        <mxCell id="a_fsm" value="&lt;b&gt;flow_fsm 手势判决&lt;/b&gt;&lt;br&gt;300 块投票→帧判定&lt;br&gt;漏桶积分 ±8" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="670" y="120" width="170" height="110" as="geometry" />

        <mxCell id="a_flow" value="&lt;b&gt;lk_flow 光流核心&lt;/b&gt;&lt;br&gt;乒乓双缓冲+行缓冲&lt;br&gt;16×16 分块 LK&lt;br&gt;Q16 定点解算" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">

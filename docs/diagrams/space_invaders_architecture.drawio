          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="de7" value="左右" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=1;entryY=0.25;" edge="1" parent="1" source="d_gest" target="d_game">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="de8" value="start / restart" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=1;entryY=0.75;" edge="1" parent="1" source="d_deb" target="d_game">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="de9" value="游戏状态" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="d_game" target="d_snap">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="de10" value="快照副本" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="d_snap" target="d_render">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="de11" value="RGB888" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="d_render" target="d_hdmi">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="dnote1" value="关键数据规模：灰度帧 320×240×8bit 双缓冲 ｜ 光流 20×15=300 块 ｜ 游戏状态 ~2 kbit/次快照 ｜ 像素 640×480@60Hz" style="text;html=1;fontSize=10;align=left;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="60" y="670" width="1200" height="25" as="geometry" />
        </mxCell>
        <mxCell id="dnote2" value="控制流：手势（摄像头域产出，跨域同步）+ 按键（系统域消抖）→ game_core FSM 门控；显示侧只读快照，绝不反写。" style="text;html=1;fontSize=10;align=left;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="60" y="700" width="1200" height="25" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="clockdom" name="3-时钟域与CDC">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="780" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="ct1" value="时钟域划分与跨域协调（实际实现）&lt;br&gt;3 个时钟：摄像头域独立异步；系统域与显示域由同一 MMCM 同源分频，STA 按同步路径分析" style="text;html=1;fontSize=17;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1F3864;" vertex="1" parent="1">
          <mxGeometry x="40" y="15" width="1200" height="45" as="geometry" />
        </mxCell>
        <mxCell id="c_blue" value="摄像头域  cam1_pclk ≈ 24 MHz" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FB;strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;fontStyle=1;fontColor=#2E6DA4;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="390" height="570" as="geometry" />
        </mxCell>
        <mxCell id="c_ov" value="&lt;b&gt;ov7725 采集 + rgb2gray&lt;/b&gt;&lt;br&gt;DVP 拼像素 + 灰度化" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="140" width="350" height="80" as="geometry" />
        </mxCell>
        <mxCell id="c_flow" value="&lt;b&gt;lk_flow 光流 + flow_fsm 手势判决&lt;/b&gt;&lt;br&gt;分块解算 + 投票/漏桶" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="260" width="350" height="80" as="geometry" />
        </mxCell>
        <mxCell id="c_xdc" value="XDC 约束：&lt;br&gt;create_clock -period 41.667ns&lt;br&gt;CLOCK_DEDICATED_ROUTE FALSE&lt;br&gt;（允许非专用时钟布线）&lt;br&gt;&lt;br&gt;独立晶振，与其他域&lt;br&gt;无频率/相位关系" style="text;html=1;fontSize=10;align=left;verticalAlign=top;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#6c8ebf;rounded=1;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="390" width="350" height="240" as="geometry" />
        </mxCell>
        <mxCell id="c_green" value="系统域  sys_clk = 50 MHz" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4FCF5;strokeColor=#82b366;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;fontStyle=1;fontColor=#2F7D4F;" vertex="1" parent="1">
          <mxGeometry x="560" y="90" width="640" height="250" as="geometry" />
        </mxCell>
        <mxCell id="c_sys" value="&lt;b&gt;debounce ×2 + game_core&lt;/b&gt;&lt;br&gt;按键消抖 / 60Hz tick&lt;br&gt;主 FSM + 对象寄存器" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="580" y="140" width="300" height="180" as="geometry" />
        </mxCell>
        <mxCell id="c_mmcm" value="&lt;b&gt;MMCM (hdmi_pll)&lt;/b&gt;&lt;br&gt;50→25MHz, locked" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="920" y="140" width="180" height="80" as="geometry" />
        </mxCell>
        <mxCell id="c_syncnote" value="同源分频：两域相位对齐&lt;br&gt;STA 按同步路径分析" style="text;html=1;fontSize=10;align=left;verticalAlign=top;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#82b366;rounded=1;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="920" y="240" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="c_orange" value="显示域  clk_25m = 25 MHz" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBF2;strokeColor=#d79b00;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;fontStyle=1;fontColor=#B35C00;" vertex="1" parent="1">
          <mxGeometry x="560" y="400" width="640" height="260" as="geometry" />
        </mxCell>
        <mxCell id="c_disp" value="&lt;b&gt;vga_timing + sprite_render&lt;/b&gt;&lt;br&gt;640×480@60&lt;br&gt;坐标比较出颜色 + 画中画" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="580" y="450" width="300" height="180" as="geometry" />
        </mxCell>
        <mxCell id="c_hdmi3" value="&lt;b&gt;HDMI 输出&lt;/b&gt;&lt;br&gt;ADV7511 配置&lt;br&gt;RGB888 24bit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="920" y="450" width="180" height="180" as="geometry" />
        </mxCell>
        <mxCell id="ce1" value="① 手势 2FF 同步器 ★&lt;br&gt;镜像反转 | set_false_path pclk→sys" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#b85450;strokeWidth=2;fontSize=10;fontColor=#b85450;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c_flow" target="c_sys">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ce2" value="② 标签双口 RAM ★ pclk 写 / 25MHz 读（画中画）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#b85450;strokeWidth=2;fontSize=10;fontColor=#b85450;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.1;entryY=1;" edge="1" parent="1" source="c_flow" target="c_orange">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="235" y="700" />
              <mxPoint x="624" y="700" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="ce3" value="③ 信箱快照 ★ toggle 每 4096 拍（81.9µs）整包复制，防画面撕裂" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#b85450;strokeWidth=2;fontSize=10;fontColor=#b85450;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c_sys" target="c_disp">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ce4" value="25 MHz" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.7;entryY=0;" edge="1" parent="1" source="c_mmcm" target="c_orange">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cnote" value="复位策略：rst_n = sys_rst_n &amp; MMCM locked（异步复位、PLL 锁定后释放）；各域复位独立打拍。" style="text;html=1;fontSize=10;align=left;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="40" y="720" width="1160" height="25" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="fsmmain" name="4-游戏主状态机">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="720" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="ft1" value="游戏主状态机（2 bit / 4 状态）—— game_core 唯一控制 FSM" style="text;html=1;fontSize=17;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1F3864;" vertex="1" parent="1">
          <mxGeometry x="40" y="15" width="1200" height="30" as="geometry" />
        </mxCell>
        <mxCell id="f_restart" value="任意状态：btn_restart↑ → 强制全量复位回 S_PLAY（优先级最高）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F6F3FC;strokeColor=#9673a6;dashed=1;fontSize=11;fontColor=#5B4B8A;align=center;" vertex="1" parent="1">
          <mxGeometry x="640" y="60" width="560" height="50" as="geometry" />
        </mxCell>
        <mxCell id="f_idle" value="&lt;b&gt;S_IDLE&lt;/b&gt;&lt;br&gt;2&#39;d0" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="120" y="150" width="130" height="90" as="geometry" />
        </mxCell>
        <mxCell id="f_play" value="&lt;b&gt;S_PLAY&lt;/b&gt;&lt;br&gt;2&#39;d1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="520" y="150" width="130" height="90" as="geometry" />
        </mxCell>
        <mxCell id="f_pause" value="&lt;b&gt;S_PAUSE&lt;/b&gt;&lt;br&gt;2&#39;d2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="920" y="150" width="130" height="90" as="geometry" />
        </mxCell>
        <mxCell id="f_over" value="&lt;b&gt;S_OVER&lt;/b&gt;&lt;br&gt;2&#39;d3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="520" y="430" width="130" height="90" as="geometry" />
        </mxCell>
        <mxCell id="f_entry" value="" style="ellipse;fillColor=#333333;strokeColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="185" width="20" height="20" as="geometry" />
        </mxCell>
        <mxCell id="fe0" value="rst_n ↓ 上电复位" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="f_entry" target="f_idle">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fe1" value="btn_start↑&lt;br&gt;（全量复位）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.35;entryX=0;entryY=0.35;" edge="1" parent="1" source="f_idle" target="f_play">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fe2" value="btn_start↑（暂停）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.35;entryX=0;entryY=0.35;" edge="1" parent="1" source="f_play" target="f_pause">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fe3" value="btn_start↑（继续）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0;exitY=0.65;entryX=1;entryY=0.65;" edge="1" parent="1" source="f_pause" target="f_play">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fe4" value="lives==0 或 敌阵触底 → win=0&lt;br&gt;敌全灭且 stage==3 → win=1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.75;exitY=1;entryX=0.75;entryY=0;strokeColor=#b85450;" edge="1" parent="1" source="f_play" target="f_over">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fe5" value="btn_start↑（全量复位）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.25;exitY=0;entryX=0.25;entryY=1;strokeColor=#82b366;" edge="1" parent="1" source="f_over" target="f_play">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fe6" value="敌全灭且 stage&lt;3 → stage_clear 序列 120 拍 → 关卡+1 后继续 PLAY" style="edgeStyle=none;curved=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#6c8ebf;exitX=0.5;exitY=0;entryX=0.85;entryY=0;" edge="1" parent="1" source="f_play" target="f_play">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="585" y="80" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="fnote" value="迁移条件在 60Hz tick 使能沿采样；优先级：复位 &gt; btn_restart↑ &gt; btn_start↑ &gt; 游戏逻辑；Moore 型输出：state 直接门控游戏推进与渲染。" style="text;html=1;fontSize=10;align=left;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="100" y="600" width="1100" height="30" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="fsmgesture" name="5-手势判决FSM">
    <mxGraphModel dx="1334" dy="1031" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="680" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="gt1" parent="1" style="text;html=1;fontSize=17;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1F3864;" value="手势判决 FSM（flow_fsm）—— 三级顺序决策，摄像头时钟域" vertex="1">
          <mxGeometry height="30" width="1300" x="40" y="15" as="geometry" />
        </mxCell>
        <mxCell id="g1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" value="&lt;b&gt;第 1 级：逐块投票&lt;/b&gt;&lt;br&gt;可信块：energy≥E_MIN 且 |u|≥0.125px&lt;br&gt;u&lt;0 → cnt_left++（tag=1 左）&lt;br&gt;u&gt;0 → cnt_right++（tag=2 右）&lt;br&gt;同时写标签 RAM（300 块）&lt;br&gt;vsync 上升沿清零票数" vertex="1">
          <mxGeometry height="170" width="380" x="60" y="140" as="geometry" />
        </mxCell>
        <mxCell id="g2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" value="&lt;b&gt;第 2 级：帧方向判定&lt;/b&gt;&lt;br&gt;frame_left = cnt_left≥2 且 ≥cnt_right+2&lt;br&gt;frame_right = 对称&lt;br&gt;票数不足或左右矛盾 → 本帧无效" vertex="1">
          <mxGeometry height="170" width="380" x="510" y="140" as="geometry" />
        </mxCell>
        <mxCell id="g3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" value="&lt;b&gt;第 3 级：漏桶积分&lt;/b&gt;&lt;br&gt;bucket ∈ [-8, +8]&lt;br&gt;帧左 → bucket-1 / 帧右 → +1&lt;br&gt;静止或矛盾 → 向 0 漏电&lt;br&gt;|bucket|≥3 才输出手势" vertex="1">
          <mxGeometry height="170" width="380" x="960" y="140" as="geometry" />
        </mxCell>
        <mxCell id="ge1" edge="1" parent="1" source="g1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="g2" value="每帧结算（vsync）">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ge2" edge="1" parent="1" source="g2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="g3" value="帧方向">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="g_ram" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" value="&lt;b&gt;标签 RAM → 画中画&lt;/b&gt;&lt;br&gt;pclk 写 / 25MHz 读&lt;br&gt;红=左 绿=右 灰=静止" vertex="1">
          <mxGeometry height="100" width="380" x="60" y="400" as="geometry" />
        </mxCell>
        <mxCell id="g_2ff" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;fontSize=11;" value="&lt;b&gt;→ 2FF 跨域 → 游戏&lt;/b&gt;&lt;br&gt;同步到 50MHz 域&lt;br&gt;镜像反转后控制炮台" vertex="1">
          <mxGeometry height="100" width="380" x="510" y="400" as="geometry" />
        </mxCell>
        <mxCell id="g_out" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" value="&lt;b&gt;输出&lt;/b&gt;&lt;br&gt;gest_left / gest_right（否则静止）" vertex="1">
          <mxGeometry height="100" width="380" x="960" y="400" as="geometry" />
        </mxCell>
        <mxCell id="ge3" edge="1" parent="1" source="g3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" target="g_out" value="阈值判决 |bucket|≥3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ge4" edge="1" parent="1" source="g_out" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" target="g_2ff">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ge5" edge="1" parent="1" source="g1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" target="g_ram" value="写标签">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="gnote" parent="1" style="text;html=1;fontSize=10;align=left;verticalAlign=middle;fontColor=#555555;" value="设计动机：LK 光流单帧误判率高（U_MIN 仅 0.125 像素/帧，靠方向一致性而非幅值）；投票+漏桶把 300 块的弱证据聚合为稳定命令，漏桶天然保留静止态。" vertex="1">
          <mxGeometry height="30" width="1300" x="40" y="560" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
